# Streamlit tester UI settings.
# Copy this file to .env on the VM or tester machine and change values as needed.

VAAK_BASE_URL=http://127.0.0.1:8478
VAAK_TOKEN=dev-demo-token
VAAK_PRINCIPAL_ID=
VAAK_CONTROLLER_ID=development
VAAK_DISPLAY_NAME=Streamlit Demo User

# Optional: where the UI saves generated proof/audio files.
VAAK_PROOF_DIR=/tmp/vaak-streamlit-proof

# Note:
# BLU_KEY/Kokoro/voice-provider keys belong to the Vaak backend service.
# Do not commit real tokens or provider keys to this repo.

