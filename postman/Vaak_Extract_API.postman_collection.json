            },
            "url": {
              "raw": "{{BASE_URL}}/v1/principals/{{PRINCIPAL_ID}}/voice/enrollment/complete",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "principals",
                "{{PRINCIPAL_ID}}",
                "voice",
                "enrollment",
                "complete"
              ]
            },
            "description": "Replace DEMO_AUDIO_B64 with real recorded audio for non-demo verification."
          }
        },
