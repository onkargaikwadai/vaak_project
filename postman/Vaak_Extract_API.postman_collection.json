{
  "info": {
    "_postman_id": "4df38ae6-460b-4f83-91a4-6cf1e5169e9b",
    "name": "Vaak Extract API",
    "description": "Import this collection into Postman. Use the LOCAL or PROD environment, then run requests top-to-bottom. Several requests automatically save response values into environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "LOCAL",
      "item": [
        {
          "name": "01 Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/healthz",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Checks that the Vaak API service is running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('service is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().ok).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Voice Model Spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/v1/voice-model/spec",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "voice-model",
                "spec"
              ]
            }
          }
        },
        {
          "name": "03 Model Quality",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/v1/models/quality",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "models",
                "quality"
              ]
            }
          }
        },
        {
          "name": "04 Create Principal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principal_id\": \"{{PRINCIPAL_ID}}\",\n  \"controller_id\": \"{{CONTROLLER_ID}}\",\n  \"display_name\": \"{{DISPLAY_NAME}}\",\n  \"identity_class\": \"developer_agent\",\n  \"persona\": {\n    \"role\": \"demo\",\n    \"tone\": \"calm\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/v1/principals",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "principals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.principal_id) pm.environment.set('PRINCIPAL_ID', body.principal_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Open Voice Enrollment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/v1/principals/{{PRINCIPAL_ID}}/voice/enrollment",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "principals",
                "{{PRINCIPAL_ID}}",
                "voice",
                "enrollment"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.session_id) pm.environment.set('ENROLL_SESSION_ID', body.session_id);",
                  "if (body.challenge) pm.environment.set('CHALLENGE', body.challenge);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Complete Voice Enrollment",
          "request": {
            "method": "POST",
            "header": [
