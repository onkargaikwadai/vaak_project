    {
      "name": "Vaak Studio",
      "item": [
        {
          "name": "01 Create Studio Character",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"character_id\": \"{{CHARACTER_ID}}\",\n  \"rights_holder_id\": \"{{CONTROLLER_ID}}\",\n  \"display_name\": \"Demo Character\",\n  \"persona\": {\n    \"tone\": \"warm\",\n    \"style\": \"clear\"\n  },\n  \"voice_origin\": \"synthetic\",\n  \"canonical_voice_version\": \"1\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/v1/studios/{{STUDIO_ID}}/characters",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "studios",
                "{{STUDIO_ID}}",
                "characters"
              ]
            }
          }
        },
        {
          "name": "02 Issue Studio Character Rights",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rights_holder_id\": \"{{CONTROLLER_ID}}\",\n  \"production_ids\": [\"{{PRODUCTION_ID}}\"],\n  \"languages\": [\"en\"],\n  \"territories\": [\"worldwide\"],\n  \"channels\": [\"local\", \"call\", \"stream\"],\n  \"usage_classes\": [\"dialogue\"],\n  \"allow_localization\": true,\n  \"allow_voice_transformation\": false,\n  \"ttl_seconds\": 31536000\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/v1/studios/{{STUDIO_ID}}/characters/{{CHARACTER_ID}}/rights",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "v1",
                "studios",
                "{{STUDIO_ID}}",
                "characters",
                "{{CHARACTER_ID}}",
                "rights"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.grant_id) pm.environment.set('GRANT_ID', body.grant_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Open Studio Live Session",
          "request": {
            "method": "POST",
            "header": [
