# Parinita Vaak GA v2.1.0 - example only. Replace all endpoints, credentials and benchmark values.
VAAK_ENV=production
VAAK_ALLOW_DEV_PROVIDERS=0

VAAK_STATE_DB=/var/lib/vaak/state.db
VAAK_AUTH_DB=/var/lib/vaak/auth.db
VAAK_QUALITY_DB=/var/lib/vaak/quality.db
VAAK_VOICE_VAULT_DB=/var/lib/vaak/voice-vault.db

# VAD + calibrated acoustic undertone gateway
VAAK_MEDIA_GATEWAY_URL=https://vaak-media.internal
VAAK_MEDIA_GATEWAY_KEY=replace-me

# Robust transformed-audio binding/watermark service
VAAK_SOFT_BINDING_URL=https://vaak-binding.internal
VAAK_SOFT_BINDING_KEY=replace-me

# Enrollment (challenge/liveness/speaker/anti-spoof) and presence/disclosure/identity evidence
VAAK_ENROLLMENT_VERIFIER_URL=https://vaak-identity.internal
VAAK_ENROLLMENT_VERIFIER_KEY=replace-me
VAAK_EVIDENCE_VERIFIER_URL=https://vaak-evidence.internal
VAAK_EVIDENCE_VERIFIER_KEY=replace-me

# Entrust/nShield-backed key service facade
VAAK_HSM_URL=https://vaak-hsm.internal
VAAK_HSM_KEY=replace-me
VAAK_ISSUER_KEY_REF=vaak/issuer
VAAK_ANCHOR_KEY_REF=vaak/anchor
VAAK_VAULT_KEY_REF=vaak/vault-wrap
VAAK_OWNER_KEY_PREFIX=vaak/owner

# Chrysalis/finality publisher
VAAK_CHRYSALIS_URL=https://chrysalis.internal
VAAK_CHRYSALIS_KEY=replace-me

# All six families are mandatory in GA. Endpoints may be Parinita-hosted model gateways.
