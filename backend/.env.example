# Optional development/test speech adapter for the Bluro ute Kokoro endpoint.
# This is selected only when development providers are allowed and BLU_KEY or
# KOKORO_API_KEY is configured. Do not commit real API keys.
# BLU_KEY=replace-me
# KOKORO_API_KEY=replace-me
KOKORO_BASE_URL=https://bluroute.denizenblu.com
KOKORO_MODEL=kokoro-82m
KOKORO_VOICE=af_bella
